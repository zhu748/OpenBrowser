# Preserve the exact input/output bytes used by frontend integrity checks.
/Browserapp/rebuild/compiler/** text eol=lf
/Browserapp/rebuild/*.js text eol=lf
/Browserapp/rebuild/*.css text eol=lf
/Browserapp/frontend/** text=auto eol=lf
/Browserapp/frontend/workbench/** -text
/Browserapp/roxy-ui/** -text
/Browserapp/scripts/desktop-ci-gates.sh text eol=lf

# Keep generated resources and vendor inputs out of hand-written code reviews.
/Browserapp/roxy-ui/** linguist-generated=true
/Browserapp/automation/vendor/** linguist-vendored=true
/Browserapp/automation/data/** linguist-generated=true
/docs/rebuild/evidence/** linguist-generated=true
